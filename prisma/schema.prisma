// Mirrors the `MeridiesUser` shape the frontend already expects
// (see meridies-app/lib/storage.ts) so the client can swap from
// localStorage to this API without changing its data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  counselor
}

model User {
  id                 String   @id @default(cuid())
  fullName           String
  email              String   @unique
  passwordHash       String
  role               Role
  onboardingStep     Int      @default(0)
  onboardingComplete Boolean  @default(false)
  /// Free-form onboarding answers — loose on purpose, mirrors the prototype.
  profile            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Counselor side: every invite code this user has generated.
  invitesGenerated InviteCode[] @relation("GeneratedInvites")

  // Student side: the single code this user redeemed, and the counselor
  // that redemption connected them to.
  redeemedInvite InviteCode? @relation("RedeemedInvite")

  counselorId String?
  counselor   User?   @relation("CounselorStudents", fields: [counselorId], references: [id])
  students    User[]  @relation("CounselorStudents")

  @@index([counselorId])
}

model InviteCode {
  id           String    @id @default(cuid())
  /// Formatted `ABC-123`, matching meridies-app/lib/invite.ts.
  code         String    @unique
  counselor    User      @relation("GeneratedInvites", fields: [counselorId], references: [id])
  counselorId  String
  redeemedBy   User?     @relation("RedeemedInvite", fields: [redeemedById], references: [id])
  redeemedById String?   @unique
  createdAt    DateTime  @default(now())
  redeemedAt   DateTime?

  @@index([counselorId])
}

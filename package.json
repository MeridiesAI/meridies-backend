{
  "name": "meridies-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --import ./test/env.ts --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.mjs",
    "test:imports-load": "node test/integration/imports-load.mjs",
    "test:caseload-load": "node test/integration/caseload-transfer-load.mjs",
    "test:perf": "node test/integration/perf-roster.mjs",
    "seed:e2e": "node scripts/seed/e2e-stack.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^5.2.6",
    "@supabase/supabase-js": "^2.112.1",
    "csv-parse": "7.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fflate": "0.8.3",
    "jose": "^5.9.6",
    "pg": "^8.23.1",
    "read-excel-file": "9.3.12",
    "stripe": "23.0.0",
    "unpdf": "1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

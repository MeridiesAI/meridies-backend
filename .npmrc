# Install devDependencies during the Railway build even though NODE_ENV=production.
# The build compiles TypeScript (`tsc`), which lives in devDependencies; without
# this, `npm ci` omits it and the build fails with "tsc: not found". `include`
# overrides the production `omit=dev`, and it only affects installs — the runtime
# `node dist/index.js` is unaffected.
include=dev

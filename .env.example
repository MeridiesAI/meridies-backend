NODE_ENV=development
PORT=4000

# Local Postgres. On Railway, DATABASE_URL is injected automatically when you
# attach a Postgres service via the reference variable ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://user:password@localhost:5432/meridies?schema=public"

# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed origins.
CORS_ORIGIN="http://localhost:3000"

NODE_ENV=development
PORT=4000

# Comma-separated allowlist. Never "*".
CORS_ORIGIN="http://localhost:3000"

# Supabase — Project Settings -> API. The backend validates the user's Supabase
# access token against this project's JWKS and then queries Postgres AS THAT
# USER (anon key + their JWT), so RLS is what actually enforces authorization.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Optional but strongly recommended in production. Used ONLY for work a user
# may not do as themselves: the cross-instance rate limiter, AI spend quotas,
# ai_runs / audit_log writes, and outbound message delivery. Without it the
# limiter falls back to per-process memory, which resets on every deploy and
# does not hold across replicas.
SUPABASE_SERVICE_ROLE_KEY=

# All product AI goes through Anthropic. Without this, /ai/* returns 503.
ANTHROPIC_API_KEY=

# Outbound email for student invitations (Resend). Without RESEND_API_KEY the
# invitation is still created but the email is skipped and logged.
RESEND_API_KEY=
# "Display Name <address@domain>". Until you verify a sending domain in Resend,
# only onboarding@resend.dev is deliverable (and only to the account owner).
INVITE_FROM_EMAIL="Meridies <onboarding@resend.dev>"
# Frontend base URL, used to build the invitation accept link (/join/<token>).
APP_URL="http://localhost:3000"

NODE_ENV=development
PORT=4000

# Comma-separated allowlist. Never "*".
CORS_ORIGIN="http://localhost:3000"

# Supabase — Project Settings -> API. The backend validates the user's Supabase
# access token against this project's JWKS and then queries Postgres AS THAT
# USER (anon key + their JWT), so RLS is what actually enforces authorization.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Optional but strongly recommended in production. Used ONLY for work a user
# may not do as themselves: the cross-instance rate limiter, AI spend quotas,
# ai_runs / audit_log writes, and outbound message delivery. Without it the
# limiter falls back to per-process memory, which resets on every deploy and
# does not hold across replicas.
SUPABASE_SERVICE_ROLE_KEY=

# All product AI goes through Anthropic. Without this, /ai/* returns 503.
ANTHROPIC_API_KEY=

# Outbound email for student invitations (Resend). Without RESEND_API_KEY the
# invitation is still created but the email is skipped and logged.
RESEND_API_KEY=
# "Display Name <address@domain>". Until you verify a sending domain in Resend,
# only onboarding@resend.dev is deliverable (and only to the account owner).
INVITE_FROM_EMAIL="Meridies <onboarding@resend.dev>"
# Frontend base URL, used to build the invitation accept link (/join/<token>).
APP_URL="http://localhost:3000"

# Outbound SMS (Twilio). Task notifications and parent alerts text through
# Twilio's REST API. Without the SID, token and a sender, texts are recorded as
# `queued` in message_deliveries and never reported as sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set ONE sender: an E.164 number you own in Twilio, or a Messaging Service SID
# (MG…). The Messaging Service wins if both are set.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Scheduled accountability sweep (red-flag escalation for every counselor).
# Both need SUPABASE_SERVICE_ROLE_KEY; without it a scheduled sweep logs and skips.
# CRON_SECRET (32+ chars, e.g. `openssl rand -hex 32`) authenticates
# POST /internal/accountability/sweep for a Railway cron service. Unset -> 503.
CRON_SECRET=
# Optional in-process schedule, in minutes (5-1440). A lease row in Postgres
# stops replicas and the cron from sweeping at the same time.
SWEEP_INTERVAL_MINUTES=

# College Scorecard API key (free: https://api.data.gov/signup/). Unset, the
# catalog ingest answers 503. Load the catalog once with
#   npx tsx scripts/ingest/scorecard.ts
# then refresh monthly with POST /internal/ingest/scorecard (Railway cron).
SCORECARD_API_KEY=

# Google / Microsoft OAuth (Connected apps). All optional; a provider without a
# client id + secret answers 503 on /integrations/<provider>/*. Needs
# SUPABASE_SERVICE_ROLE_KEY too — tokens live in a service-role-only table.
# The redirect URI is an APP page (built from APP_URL above), not this API —
# it runs under the counselor's session and posts the code to
# POST /integrations/<provider>/complete. Register exactly:
#   <APP_URL>/dashboard/counselor/data-hub/callback/google
#   <APP_URL>/dashboard/counselor/data-hub/callback/microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts work and personal accounts; Teams links need a work account.
MICROSOFT_TENANT=common
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts stored tokens
# with AES-256-GCM. Changing it means every counselor reconnects.
INTEGRATION_TOKEN_KEY=
